{
  "nolex_pattern_group": true,
  "version": 1,
  "name": "German Phone Numbers",
  "description": "German phone formats: +49 30 12345678, 030/12345678, 0151 12345678",
  "patterns": [
    {
      "name": "German Phone (+49)",
      "regex": "\\+49[\\s.-]?\\d{2,4}[\\s.-]?\\d{4,8}",
      "flags": "g",
      "replacement": "***DE_PHONE_REDACTED***"
    },
    {
      "name": "German Phone (0-prefix)",
      "regex": "0\\d{2,4}[\\s./-]?\\d{4,8}",
      "flags": "g",
      "replacement": "***DE_PHONE_REDACTED***"
    }
  ]
}
