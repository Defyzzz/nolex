{
  "nolex_pattern_group": true,
  "version": 1,
  "name": "Chinese Phone Numbers",
  "description": "Chinese phone formats: +86 138 0013 8000, 13800138000",
  "patterns": [
    {
      "name": "Chinese Mobile (+86)",
      "regex": "\\+86[\\s.-]?1[3-9]\\d[\\s.-]?\\d{4}[\\s.-]?\\d{4}",
      "flags": "g",
      "replacement": "***CN_PHONE_REDACTED***"
    },
    {
      "name": "Chinese Mobile (no prefix)",
      "regex": "\\b1[3-9]\\d{9}\\b",
      "flags": "g",
      "replacement": "***CN_PHONE_REDACTED***"
    }
  ]
}
