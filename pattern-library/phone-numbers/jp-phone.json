{
  "nolex_pattern_group": true,
  "version": 1,
  "name": "Japanese Phone Numbers",
  "description": "Japanese phone formats: +81 90-1234-5678, 090-1234-5678, 03-1234-5678",
  "patterns": [
    {
      "name": "Japanese Phone (+81)",
      "regex": "\\+81[\\s.-]?[0-9]{1,4}[\\s.-]?[0-9]{1,4}[\\s.-]?[0-9]{4}",
      "flags": "g",
      "replacement": "***JP_PHONE_REDACTED***"
    },
    {
      "name": "Japanese Mobile (090/080/070)",
      "regex": "\\b0[789]0[\\s.-]?\\d{4}[\\s.-]?\\d{4}\\b",
      "flags": "g",
      "replacement": "***JP_PHONE_REDACTED***"
    },
    {
      "name": "Japanese Landline (0x)",
      "regex": "\\b0\\d{1,3}[\\s.-]?\\d{2,4}[\\s.-]?\\d{4}\\b",
      "flags": "g",
      "replacement": "***JP_PHONE_REDACTED***"
    }
  ]
}
