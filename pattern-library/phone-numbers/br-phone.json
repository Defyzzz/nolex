{
  "nolex_pattern_group": true,
  "version": 1,
  "name": "Brazilian Phone Numbers",
  "description": "Brazilian phone formats: +55 11 91234-5678, (11) 91234-5678",
  "patterns": [
    {
      "name": "Brazilian Phone (+55)",
      "regex": "\\+55[\\s.-]?\\d{2}[\\s.-]?9?\\d{4}[\\s.-]?\\d{4}",
      "flags": "g",
      "replacement": "***BR_PHONE_REDACTED***"
    },
    {
      "name": "Brazilian Phone (local)",
      "regex": "\\(?\\d{2}\\)?[\\s.-]?9?\\d{4}[\\s.-]?\\d{4}",
      "flags": "g",
      "replacement": "***BR_PHONE_REDACTED***"
    }
  ]
}
