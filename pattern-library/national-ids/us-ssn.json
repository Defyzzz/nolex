{
  "nolex_pattern_group": true,
  "version": 1,
  "name": "US Social Security Number",
  "description": "US SSN formats: 123-45-6789, 123 45 6789",
  "patterns": [
    {
      "name": "US SSN (dashes)",
      "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "flags": "g",
      "replacement": "***SSN_REDACTED***"
    },
    {
      "name": "US SSN (spaces)",
      "regex": "\\b\\d{3}\\s\\d{2}\\s\\d{4}\\b",
      "flags": "g",
      "replacement": "***SSN_REDACTED***"
    }
  ]
}
