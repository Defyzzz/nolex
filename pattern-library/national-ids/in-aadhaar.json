{
  "nolex_pattern_group": true,
  "version": 1,
  "name": "Indian Aadhaar Number",
  "description": "Indian Aadhaar format: 1234 5678 9012",
  "patterns": [
    {
      "name": "Aadhaar Number",
      "regex": "\\b[2-9]\\d{3}[\\s.-]?\\d{4}[\\s.-]?\\d{4}\\b",
      "flags": "g",
      "replacement": "***AADHAAR_REDACTED***"
    },
    {
      "name": "Indian PAN",
      "regex": "\\b[A-Z]{5}\\d{4}[A-Z]\\b",
      "flags": "g",
      "replacement": "***PAN_REDACTED***"
    }
  ]
}
