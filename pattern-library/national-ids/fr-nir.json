{
  "nolex_pattern_group": true,
  "version": 1,
  "name": "French Social Security Number (NIR)",
  "description": "French NIR format: 1 85 05 78 006 084 36",
  "patterns": [
    {
      "name": "French NIR",
      "regex": "\\b[12][\\s.-]?\\d{2}[\\s.-]?(?:0[1-9]|1[0-2])[\\s.-]?\\d{2,3}[\\s.-]?\\d{3}[\\s.-]?\\d{3}[\\s.-]?\\d{2}\\b",
      "flags": "g",
      "replacement": "***FR_NIR_REDACTED***"
    }
  ]
}
