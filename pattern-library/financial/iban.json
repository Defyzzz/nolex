{
  "nolex_pattern_group": true,
  "version": 1,
  "name": "IBAN & SWIFT",
  "description": "International Bank Account Numbers and SWIFT/BIC codes",
  "patterns": [
    {
      "name": "IBAN",
      "regex": "\\b[A-Z]{2}\\d{2}\\s?[A-Z0-9]{4}\\s?\\d{4}\\s?\\d{4}\\s?\\d{4}\\s?\\d{0,4}\\s?\\d{0,2}\\b",
      "flags": "g",
      "replacement": "***IBAN_REDACTED***"
    },
    {
      "name": "SWIFT/BIC Code",
      "regex": "\\b[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}(?:[A-Z0-9]{3})?\\b",
      "flags": "g",
      "replacement": "***SWIFT_REDACTED***"
    }
  ]
}
